---
export interface Props {
  category?: string;
  functionName?: string;
}

const { category = 'general', functionName = '' } = Astro.props;

const courses = [
  {
    id: 'excel-essentials',
    name: 'Excel Essentials: The Complete Guide',
    provider: 'Udemy',
    rating: 4.7,
    students: 125000,
    price: '$12.99',
    originalPrice: '$49.99',
    url: 'https://www.udemy.com/course/excel-essentials/',
    description: 'Master Excel from beginner to advanced with real-world examples.',
    categories: ['math', 'statistical', 'text', 'datetime'],
  },
  {
    id: 'google-sheets-master',
    name: 'Google Sheets Masterclass',
    provider: 'Coursera',
    rating: 4.8,
    students: 45000,
    price: 'Free',
    originalPrice: '',
    url: 'https://www.coursera.org/learn/google-sheets',
    description: 'Learn Google Sheets from basics to advanced automation.',
    categories: ['google-sheets', 'database'],
  },
  {
    id: 'excel-vba',
    name: 'Excel VBA & Macros: Complete Automation',
    provider: 'Udemy',
    rating: 4.6,
    students: 38000,
    price: '$14.99',
    originalPrice: '$79.99',
    url: 'https://www.udemy.com/course/excel-vba/',
    description: 'Automate your Excel workflows with VBA programming.',
    categories: ['engineering', 'information'],
  },
  {
    id: 'financial-modeling',
    name: 'Financial Modeling in Excel',
    provider: 'LinkedIn Learning',
    rating: 4.9,
    students: 52000,
    price: '$29.99/mo',
    originalPrice: '',
    url: 'https://www.linkedin.com/learning/financial-modeling',
    description: 'Build professional financial models for business analysis.',
    categories: ['financial'],
  },
  {
    id: 'data-analysis',
    name: 'Data Analysis with Excel & Power BI',
    provider: 'Udemy',
    rating: 4.8,
    students: 89000,
    price: '$16.99',
    originalPrice: '$89.99',
    url: 'https://www.udemy.com/course/data-analysis-excel-powerbi/',
    description: 'Transform raw data into actionable insights.',
    categories: ['statistical', 'lookup', 'database'],
  },
];

const relevantCourses = courses.filter((course) =>
  course.categories.includes(category) || category === 'general'
).slice(0, 3);
---

<section class="affiliate-courses mt-8 p-6 rounded-xl bg-gradient-to-r from-gray-50 to-primary-50 border border-gray-200">
  <div class="flex items-center gap-2 mb-4">
    <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
    </svg>
    <h3 class="text-lg font-semibold text-gray-900">Recommended Courses</h3>
    <span class="text-xs px-2 py-1 rounded bg-primary-100 text-primary-600">Affiliate</span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    {relevantCourses.map((course) => (
      <a href={course.url} target="_blank" rel="noopener noreferrer nofollow"
        class="group block p-4 rounded-lg bg-white border border-gray-100 hover:shadow-md hover:border-primary-200 transition-all">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-medium px-2 py-1 rounded bg-gray-100 text-gray-600">{course.provider}</span>
          <div class="flex items-center gap-1">
            <svg class="w-4 h-4 text-yellow-500" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
            <span class="text-sm font-medium">{course.rating}</span>
          </div>
        </div>
        <h4 class="text-sm font-semibold text-gray-900 group-hover:text-primary-500 transition-colors mb-2 line-clamp-2">
          {course.name}
        </h4>
        <p class="text-xs text-gray-500 mb-3 line-clamp-2">{course.description}</p>
        <div class="flex items-center justify-between">
          <div>
            <span class="text-sm font-bold text-primary-600">{course.price}</span>
            {course.originalPrice && (
              <span class="text-xs text-gray-400 line-through ml-1">{course.originalPrice}</span>
            )}
          </div>
          <span class="text-xs text-gray-400">{course.students.toLocaleString()} students</span>
        </div>
      </a>
    ))}
  </div>

  <p class="mt-4 text-xs text-gray-400">
    * These are affiliate links. We may earn a commission if you purchase through these links.
  </p>
</section>