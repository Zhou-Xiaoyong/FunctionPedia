<script>
  let currentFunction = '';
  let parameters = [];
  let paramValues = {};
  
  function initBuilder(funcName, funcParams) {
    currentFunction = funcName;
    parameters = funcParams;
    paramValues = {};
    parameters.forEach(p => {
      paramValues[p.name] = p.defaultValue || '';
    });
    renderBuilder();
  }
  
  function updateParam(name, value) {
    paramValues[name] = value;
    renderPreview();
  }
  
  function renderBuilder() {
    const container = document.getElementById('formula-builder-container');
    if (!container) return;
    
    let html = `
      <div class="space-y-4">
        <div class="p-4 bg-gray-900 rounded-lg">
          <code class="text-accent-400 font-mono text-lg">=${currentFunction}</code>
        </div>
        <div class="space-y-3">
    `;
    
    parameters.forEach((param, index) => {
      const isRequired = param.required ? 'required' : '';
      const placeholder = param.description || `Enter ${param.name}`;
      const value = paramValues[param.name] || '';
      
      html += `
        <div class="relative">
          <label class="block text-sm font-medium text-gray-700 mb-1">
            <span class="font-mono text-primary-600">${param.name}</span>
            ${param.required ? '<span class="text-red-500 ml-1">*</span>' : ''}
          </label>
          <input
            type="text"
            ${isRequired}
            value="${value}"
            placeholder="${placeholder}"
            oninput="updateParam('${param.name}', this.value)"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"
          />
          ${param.description && (
            `<p class="mt-1 text-xs text-gray-500">${param.description}</p>`
          )}
          ${index > 0 && (
            `<div class="absolute left-0 top-8 w-1 h-8 bg-gray-300 -ml-3"></div>`
          )}
        </div>
      `;
    });
    
    html += `
        </div>
        <div class="border-t border-gray-200 pt-4">
          <div class="flex items-center justify-between">
            <span class="text-sm font-medium text-gray-700">Preview:</span>
            <button onclick="copyFormula()" class="px-3 py-1 text-sm text-primary-600 hover:text-primary-700 font-medium">
              📋 Copy
            </button>
          </div>
          <div id="formula-preview" class="mt-2 p-3 bg-gray-900 rounded-lg font-mono text-accent-400 text-sm break-all"></div>
        </div>
      </div>
    `;
    
    container.innerHTML = html;
    renderPreview();
  }
  
  function renderPreview() {
    const preview = document.getElementById('formula-preview');
    if (!preview) return;
    
    let paramStr = parameters.map(p => {
      const val = paramValues[p.name];
      if (val === '') {
        return `<span class="text-gray-500">[${p.name}]</span>`;
      }
      if (/^[0-9.]+$/.test(val)) {
        return val;
      }
      if (/^[A-Z]+[0-9]+(:[A-Z]+[0-9]+)?$/.test(val)) {
        return val;
      }
      return `"${val}"`;
    }).join(', ');
    
    preview.innerHTML = `=${currentFunction}(${paramStr})`;
  }
  
  function copyFormula() {
    const preview = document.getElementById('formula-preview');
    if (!preview) return;
    
    const text = preview.innerText;
    navigator.clipboard.writeText(text).then(() => {
      const btn = document.querySelector('button[onclick="copyFormula()"]');
      if (btn) {
        const original = btn.innerHTML;
        btn.innerHTML = '✅ Copied!';
        setTimeout(() => {
          btn.innerHTML = original;
        }, 2000);
      }
    }).catch(err => {
      console.error('Failed to copy:', err);
    });
  }
</script>

<div class="formula-builder">
  <div class="bg-white border border-gray-200 rounded-xl p-6">
    <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
      <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
      Interactive Formula Builder
    </h3>
    <p class="text-sm text-gray-500 mb-4">Fill in the parameters below to build your formula. The preview updates in real-time.</p>
    <div id="formula-builder-container">
      <div class="text-center py-8 text-gray-400">
        Select a function to start building
      </div>
    </div>
  </div>
</div>

<script>
  window.initFormulaBuilder = initBuilder;
</script>