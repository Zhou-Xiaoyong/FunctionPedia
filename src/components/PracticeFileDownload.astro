---
interface Props {
  functionName: string;
  functionSlug: string;
  description?: string;
  practiceData?: {
    sheets: Array<{
      name: string;
      data: string[][];
    }>;
  };
}

const { functionName, functionSlug, description, practiceData } = Astro.props;
---

<script>
  function downloadPracticeFile() {
    const functionName = document.getElementById('download-fn-name')?.textContent || 'practice';
    const functionSlug = document.getElementById('download-fn-slug')?.textContent || 'practice';
    
    let csvContent = '';
    const sheetsData = window.practiceSheetsData || [];
    
    if (sheetsData.length > 0) {
      sheetsData.forEach((sheet, sheetIndex) => {
        if (sheetIndex > 0) {
          csvContent += '\n\n';
        }
        csvContent += `=== ${sheet.name} ===\n`;
        sheet.data.forEach((row) => {
          csvContent += row.map(cell => {
            if (typeof cell === 'string' && (cell.includes(',') || cell.includes('"') || cell.includes('\n'))) {
              return `"${cell.replace(/"/g, '""')}"`;
            }
            return cell;
          }).join(',');
          csvContent += '\n';
        });
      });
    } else {
      csvContent = generateDefaultPracticeData(functionName);
    }
    
    const BOM = '\uFEFF';
    const blob = new Blob([BOM + csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.setAttribute('href', url);
    link.setAttribute('download', `${functionSlug}-practice.csv`);
    link.style.visibility = 'hidden';
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
    
    const btn = document.getElementById('download-btn');
    if (btn) {
      const originalText = btn.innerHTML;
      btn.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Downloaded!';
      setTimeout(() => {
        btn.innerHTML = originalText;
      }, 2000);
    }
  }
  
  function generateDefaultPracticeData(functionName) {
    const data = [
      ['Practice Worksheet', '', ''],
      [`${functionName} Function Practice`, '', ''],
      ['', '', ''],
      ['Exercise 1: Basic Usage', '', ''],
      ['ID', 'Name', 'Value'],
      [101, 'Alice', 100],
      [102, 'Bob', 200],
      [103, 'Charlie', 150],
      [104, 'Diana', 300],
      [105, 'Eve', 250],
      ['', '', ''],
      ['Instructions:', '', ''],
      ['1. Use the ' + functionName + ' function to look up values', '', ''],
      ['2. Practice with different parameters', '', ''],
      ['3. Try approximate and exact match modes', '', ''],
    ];
    
    let csv = '';
    data.forEach(row => {
      csv += row.map(cell => {
        if (typeof cell === 'string' && (cell.includes(',') || cell.includes('"'))) {
          return `"${cell.replace(/"/g, '""')}"`;
        }
        return cell;
      }).join(',');
      csv += '\n';
    });
    return csv;
  }
  
  window.downloadPracticeFile = downloadPracticeFile;
</script>

{practiceData && practiceData.sheets && practiceData.sheets.length > 0 && (
  <script define:vars={{ sheets: practiceData.sheets }}>
    window.practiceSheetsData = sheets;
  </script>
)}

<div class="bg-gradient-to-r from-primary-50 to-accent-50 rounded-xl border border-primary-200 p-6">
  <div class="flex flex-col md:flex-row items-center justify-between gap-4">
    <div>
      <h3 id="download-fn-name" class="text-lg font-semibold text-gray-900 mb-2 hidden">{functionName}</h3>
      <span id="download-fn-slug" class="hidden">{functionSlug}</span>
      <h3 class="text-lg font-semibold text-gray-900 mb-2">
        Practice {functionName.toUpperCase()} with Real Data
      </h3>
      <p class="text-sm text-gray-600">
        {description || `Download a sample CSV file with pre-populated data and practice exercises for the ${functionName.toUpperCase()} function. Works in both Excel and Google Sheets.`}
      </p>
    </div>
    <button
      id="download-btn"
      onclick="downloadPracticeFile()"
      class="inline-flex items-center gap-3 px-6 py-3 rounded-xl bg-primary-500 text-white font-medium hover:bg-primary-600 transition-colors shadow-md cursor-pointer"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
      Download .CSV File
    </button>
  </div>
  <div class="mt-4 flex items-center gap-4 text-xs text-gray-500">
    <span class="flex items-center gap-1">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
      Works in Google Sheets
    </span>
    <span class="flex items-center gap-1">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
      Compatible with Excel
    </span>
    <span class="flex items-center gap-1">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
      Includes exercises
    </span>
  </div>
  <p class="mt-2 text-xs text-gray-400">
    File format: CSV (comma-separated values) - opens in Excel, Google Sheets, and all spreadsheet apps
  </p>
</div>