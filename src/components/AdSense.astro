---
export interface Props {
  slot: string;
  format?: string;
  responsive?: boolean;
}

const { slot, format = 'auto', responsive = true } = Astro.props;
---

<div class="adsense-container mb-8">
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX"
    crossorigin="anonymous"></script>
  <ins class="adsbygoogle"
    style={responsive ? `display:block;${format === 'fluid' ? '' : 'max-width:100%;'}` : `display:block;width:${format === 'horizontal' ? '728px' : '300px'};height:${format === 'horizontal' ? '90px' : '250px'};margin:0 auto;`}
    data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
    data-ad-slot={slot}
    data-ad-format={responsive ? 'auto' : format}
    data-full-width-responsive="true"></ins>
  <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
</div>