---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../utils/config';

const tutorials = [];
const dataModules = import.meta.glob('../../data/tutorials/**/*.json', { eager: true });
for (const path in dataModules) {
  const t = dataModules[path];
  if (t && t.slug) {
    tutorials.push(t);
  }
}

tutorials.sort((a, b) => a.title.localeCompare(b.title));

const title = `Tutorials | ${SITE.title}`;
const description = 'Step-by-step guides and tutorials for mastering Excel and Google Sheets functions. Learn function combinations, advanced formulas, and real-world spreadsheet solutions.';
const canonical = `${SITE.url}/tutorial/`;
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900">Spreadsheet Tutorials</h1>
      <p class="mt-2 text-lg text-gray-600">Master Excel and Google Sheets with step-by-step guides</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {tutorials.map((tutorial) => (
        <a href={`/tutorial/${tutorial.slug}/`} class="group block p-6 rounded-xl bg-white border border-gray-200 hover:border-primary-500 hover:shadow-lg transition-all">
          <div class="flex flex-wrap gap-2 mb-4">
            {tutorial.tags.map((tag) => (
              <span class="inline-flex items-center px-2 py-1 rounded-full bg-primary-50 text-xs font-medium text-primary-700">
                {tag}
              </span>
            ))}
          </div>
          <h2 class="text-lg font-bold text-gray-900 group-hover:text-primary-500 transition-colors mb-2">{tutorial.title}</h2>
          <p class="text-sm text-gray-500 line-clamp-3">{tutorial.description}</p>
          <div class="mt-4 flex items-center text-sm text-gray-400">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            {tutorial.estimatedTime || '10 min read'}
          </div>
        </a>
      ))}
    </div>

    {tutorials.length === 0 && (
      <div class="text-center py-16">
        <div class="text-6xl mb-4">📚</div>
        <h2 class="text-xl font-bold text-gray-900 mb-2">Tutorials Coming Soon</h2>
        <p class="text-gray-500">More tutorials are being added. Check back soon!</p>
      </div>
    )}

    <div class="mt-12 p-6 rounded-xl bg-gradient-to-r from-primary-50 to-accent-50 border border-primary-100">
      <div class="flex items-start gap-4">
        <div class="w-12 h-12 rounded-xl bg-primary-500 flex items-center justify-center text-white text-xl flex-shrink-0">💡</div>
        <div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Need a specific tutorial?</h3>
          <p class="text-sm text-gray-600">Let us know what you'd like to learn! Whether it's advanced formula techniques, business templates, or specific function combinations, we're creating content based on your needs.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>