---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../utils/config';
import { generateBreadcrumbSchema, generateArticleSchema } from '../../utils/seo';

export function getStaticPaths() {
  const tutorials = [];
  const dataModules = import.meta.glob('../../data/tutorials/**/*.json', { eager: true });
  for (const path in dataModules) {
    const t = dataModules[path];
    if (t && t.slug) {
      tutorials.push(t);
    }
  }
  return tutorials.map((t) => ({
    params: { slug: t.slug },
    props: { tutorial: t },
  }));
}

const { tutorial } = Astro.props;

if (!tutorial) {
  return Astro.redirect('/tutorial/');
}

const breadcrumbs = [
  { name: 'Home', url: SITE.url },
  { name: 'Tutorials', url: `${SITE.url}/tutorial/` },
  { name: tutorial.title, url: `${SITE.url}/tutorial/${tutorial.slug}/` },
];

const articleSchema = generateArticleSchema(tutorial.title, tutorial.description, `${SITE.url}/tutorial/${tutorial.slug}/`, 'tutorial');
const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);

const title = `${tutorial.title} — ${SITE.title}`;
const description = tutorial.description;
const canonical = `${SITE.url}/tutorial/${tutorial.slug}/`;
---

<BaseLayout title={title} description={description} canonical={canonical} schema={[articleSchema, breadcrumbSchema]}>
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
    <ol class="flex items-center gap-2 text-sm text-gray-500">
      <li><a href="/" class="hover:text-primary-500 transition-colors">Home</a></li>
      <li>/</li>
      <li><a href="/tutorial/" class="hover:text-primary-500 transition-colors">Tutorials</a></li>
      <li>/</li>
      <li class="font-medium text-gray-900">{tutorial.title}</li>
    </ol>
  </nav>

  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
    <header class="mb-10">
      <div class="flex flex-wrap gap-2 mb-4">
        {tutorial.tags.map((tag) => (
          <span class="inline-flex items-center px-3 py-1 rounded-full bg-primary-50 border border-primary-200 text-xs font-medium text-primary-700">
            {tag}
          </span>
        ))}
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-4">{tutorial.title}</h1>
      <p class="text-lg text-gray-600 leading-relaxed">{tutorial.description}</p>
    </header>

    {tutorial.intro && (
      <section class="mb-10 p-6 rounded-xl bg-primary-50 border border-primary-200">
        <h2 class="text-lg font-semibold text-gray-900 mb-3">Introduction</h2>
        <p class="text-gray-700 leading-relaxed">{tutorial.intro}</p>
      </section>
    )}

    {tutorial.prerequisites && tutorial.prerequisites.length > 0 && (
      <section class="mb-10">
        <h2 class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2">
          <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Prerequisites
        </h2>
        <ul class="space-y-2">
          {tutorial.prerequisites.map((item) => (
            <li class="flex items-start gap-2 p-3 rounded-lg bg-gray-50">
              <svg class="w-5 h-5 text-primary-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span class="text-sm text-gray-700">{item}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {tutorial.sections && tutorial.sections.length > 0 && (
      <div class="space-y-12">
        {tutorial.sections.map((section, idx) => (
          <section id={`section-${idx + 1}`}>
            <h2 class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2">
              <span class="w-8 h-8 rounded-full bg-primary-500 text-white flex items-center justify-center text-sm font-bold">{idx + 1}</span>
              {section.title}
            </h2>
            
            {section.content && (
              <div class="prose prose-gray max-w-none mb-6">
                <p class="text-gray-700 leading-relaxed">{section.content}</p>
              </div>
            )}

            {section.steps && section.steps.length > 0 && (
              <div class="space-y-4 mb-6">
                {section.steps.map((step, sIdx) => (
                  <div class="flex items-start gap-4">
                    <div class="w-8 h-8 rounded-full bg-gray-100 text-gray-600 flex items-center justify-center text-sm font-bold flex-shrink-0">{sIdx + 1}</div>
                    <div>
                      <h3 class="text-sm font-semibold text-gray-900 mb-1">{step.name}</h3>
                      <p class="text-sm text-gray-600">{step.text}</p>
                      {step.formula && (
                        <div class="mt-3 p-4 bg-gray-900 rounded-lg overflow-x-auto">
                          <code class="text-accent-400 font-mono text-sm">{step.formula}</code>
                        </div>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            )}

            {section.example && (
              <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
                <div class="p-4 bg-gray-50 border-b border-gray-200">
                  <h3 class="text-sm font-semibold text-gray-900">Example</h3>
                </div>
                <div class="p-4 bg-gray-900">
                  <code class="text-accent-400 font-mono text-sm">{section.example.formula}</code>
                </div>
                {section.example.result && (
                  <div class="p-4 bg-accent-50">
                    <span class="text-xs font-semibold text-accent-700 uppercase">Result: </span>
                    <span class="font-mono font-bold text-accent-700">{section.example.result}</span>
                  </div>
                )}
                {section.example.explanation && (
                  <div class="p-4">
                    <p class="text-sm text-gray-600">{section.example.explanation}</p>
                  </div>
                )}
              </div>
            )}

            {section.tips && section.tips.length > 0 && (
              <div class="mt-6 space-y-2">
                {section.tips.map((tip) => (
                  <div class="flex items-start gap-2 p-3 rounded-lg bg-yellow-50 border border-yellow-100">
                    <svg class="w-5 h-5 text-yellow-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    <p class="text-sm text-gray-700">{tip}</p>
                  </div>
                ))}
              </div>
            )}
          </section>
        ))}
      </div>
    )}

    {tutorial.functionsUsed && tutorial.functionsUsed.length > 0 && (
      <section class="mb-10">
        <h2 class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2">
          <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          Functions Used
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {tutorial.functionsUsed.map((fn) => (
            <a href={`/function/${fn.slug}/`} class="group block p-4 rounded-lg bg-white border border-gray-200 hover:border-primary-500 hover:shadow-md transition-all">
              <h3 class="text-sm font-semibold font-mono text-gray-900 group-hover:text-primary-500 transition-colors">{fn.name.toUpperCase()}</h3>
              <p class="mt-1 text-xs text-gray-500 line-clamp-2">{fn.description}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    {tutorial.summary && (
      <section class="mb-10 p-6 rounded-xl bg-accent-50 border border-accent-200">
        <h2 class="text-lg font-semibold text-gray-900 mb-3">Summary</h2>
        <p class="text-gray-700 leading-relaxed">{tutorial.summary}</p>
      </section>
    )}

    {tutorial.nextSteps && tutorial.nextSteps.length > 0 && (
      <section>
        <h2 class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2">
          <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          Next Steps
        </h2>
        <ul class="space-y-2">
          {tutorial.nextSteps.map((step) => (
            <li class="flex items-start gap-2 p-3 rounded-lg bg-gray-50">
              <svg class="w-5 h-5 text-accent-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              <span class="text-sm text-gray-700">{step}</span>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>