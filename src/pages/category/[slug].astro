---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, CATEGORIES } from '../../utils/config';

// Export static paths for all categories
export function getStaticPaths() {
  return CATEGORIES.map((cat) => ({
    params: { slug: cat.slug },
  }));
}

const { slug } = Astro.params;
const catInfo = CATEGORIES.find((c) => c.slug === slug);

if (!catInfo) {
  return Astro.redirect('/category');
}

// Collect all function data for this category
const functions = [];
const dataModules = import.meta.glob('../../data/functions/**/*.json', { eager: true });

for (const path in dataModules) {
  const fn = dataModules[path];
  if (fn && fn.category === slug) {
    functions.push(fn);
  }
}

functions.sort((a, b) => a.name.localeCompare(b.name));

const title = `${catInfo.name} — Excel & Google Sheets Functions | ${SITE.title}`;
const description = catInfo.description;
const canonical = `${SITE.url}/category/${slug}/`;

const breadcrumbs = [
  { name: 'Home', url: SITE.url },
  { name: 'Categories', url: `${SITE.url}/category/` },
  { name: catInfo.name, url: `${SITE.url}/category/${slug}/` },
];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={[{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: breadcrumbs.map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.name, item: b.url })) }]}>
  <!-- Breadcrumb -->
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
    <ol class="flex items-center gap-2 text-sm text-gray-500">
      <li><a href="/" class="hover:text-primary-500">Home</a></li>
      <li>/</li>
      <li><a href="/category/" class="hover:text-primary-500">Categories</a></li>
      <li>/</li>
      <li class="font-medium text-gray-900">{catInfo.name}</li>
    </ol>
  </nav>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Category header -->
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-2">
        <span class="text-3xl">{catInfo.icon}</span>
        <h1 class="text-3xl font-bold text-gray-900">{catInfo.name}</h1>
        <span class="text-sm text-gray-400 bg-gray-50 px-3 py-1 rounded-full">{functions.length} functions</span>
      </div>
      <p class="text-lg text-gray-600">{catInfo.description}</p>
    </div>

    <!-- Function grid -->
    {functions.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        {functions.map((fn) => (
          <a href={`/function/${fn.slug}/`} class="group block p-5 rounded-xl bg-white border border-gray-200 hover:border-primary-500 hover:shadow-lg transition-all">
            <div class="flex items-center justify-between mb-2">
              <h2 class="text-lg font-bold font-mono text-gray-900 group-hover:text-primary-500 transition-colors">{fn.name.toUpperCase()}</h2>
              <svg class="w-4 h-4 text-gray-300 group-hover:text-primary-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
            <p class="text-sm text-gray-500 line-clamp-3">{fn.tldr || fn.description}</p>
          </a>
        ))}
      </div>
    ) : (
      <div class="text-center py-16">
        <p class="text-gray-500">Functions in this category are being added soon!</p>
        <a href="/function/" class="mt-4 inline-flex items-center text-primary-500 font-medium hover:text-primary-600">Browse all functions →</a>
      </div>
    )}

    <!-- Other categories -->
    <div class="mt-16 pt-10 border-t border-gray-100">
      <h2 class="text-xl font-bold text-gray-900 mb-6">Other Categories</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
        {CATEGORIES.filter((c) => c.slug !== slug).map((cat) => (
          <a href={`/category/${cat.slug}/`} class="group block p-4 rounded-lg bg-white border border-gray-200 hover:border-primary-500 hover:shadow-md transition-all">
            <div class="flex items-center gap-2">
              <span class="text-lg">{cat.icon}</span>
              <h3 class="text-sm font-semibold text-gray-900 group-hover:text-primary-500 transition-colors">{cat.name}</h3>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
