---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../utils/config';
---

<BaseLayout title="404 — Page Not Found | FunctionPedia" description="The page you are looking for does not exist." canonical={`${SITE.url}/404`}>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
    <div class="mb-8">
      <span class="text-8xl font-extrabold text-primary-500 font-mono">404</span>
    </div>
    <h1 class="text-3xl font-bold text-gray-900 mb-4">Page Not Found</h1>
    <p class="text-lg text-gray-600 mb-8">
      The page you are looking for doesn't exist or has been moved.
    </p>
    <div class="flex items-center justify-center gap-4">
      <a href="/" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-primary-500 text-white font-medium hover:bg-primary-600 transition-colors shadow-md">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
        Back to Home
      </a>
      <a href="/function/" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-white border border-gray-200 text-gray-700 font-medium hover:border-primary-500 hover:text-primary-500 transition-colors">
        Browse Functions
      </a>
    </div>
  </div>
</BaseLayout>
