---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../utils/config';

const freeTemplates = [
  {
    id: 'budget-basic',
    name: 'Basic Budget Tracker',
    description: 'A simple yet effective budget tracker to manage monthly income and expenses.',
    price: 'Free',
    type: 'free',
    platform: 'Google Sheets',
    features: ['Income tracking', 'Expense categorization', 'Monthly summary', 'Savings goal'],
    image: 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Simple%20budget%20tracker%20Google%20Sheets%20template%20with%20income%20and%20expense%20categories&image_size=square',
    url: '#',
  },
  {
    id: 'todo-list',
    name: 'Productivity To-Do List',
    description: 'Organize your tasks with priority levels, due dates, and progress tracking.',
    price: 'Free',
    type: 'free',
    platform: 'Excel',
    features: ['Task prioritization', 'Due date alerts', 'Progress tracking', 'Category tags'],
    image: 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Productivity%20todo%20list%20Excel%20template%20with%20task%20categories%20and%20progress%20bars&image_size=square',
    url: '#',
  },
  {
    id: 'sales-lead',
    name: 'Sales Lead Tracker',
    description: 'Track potential customers through your sales pipeline with this simple template.',
    price: 'Free',
    type: 'free',
    platform: 'Google Sheets',
    features: ['Lead status', 'Contact info', 'Follow-up dates', 'Deal value'],
    image: 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Sales%20lead%20tracker%20Google%20Sheets%20template%20with%20pipeline%20stages&image_size=square',
    url: '#',
  },
];

const paidTemplates = [
  {
    id: 'budget-tracker',
    name: 'Complete Budget Tracker',
    description: 'A comprehensive budget tracker with income/expense categories, monthly summaries, and visual charts.',
    price: '$19',
    originalPrice: '$29',
    type: 'paid',
    platform: 'Etsy',
    rating: 4.9,
    reviews: 156,
    features: ['Monthly budget planning', 'Expense tracking', 'Income vs expense charts', 'Savings goals', 'Debt tracker', 'Yearly summary'],
    image: 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Complete%20budget%20tracker%20spreadsheet%20dashboard%20with%20colorful%20charts%20and%20financial%20data&image_size=square',
    url: '#',
  },
  {
    id: 'inventory-manager',
    name: 'Inventory Management System',
    description: 'Track stock levels, reorder points, and sales history with automated alerts.',
    price: '$29',
    originalPrice: '$49',
    type: 'paid',
    platform: 'Gumroad',
    rating: 4.8,
    reviews: 89,
    features: ['Stock level tracking', 'Reorder alerts', 'Sales history', 'Low stock warnings', 'Supplier management'],
    image: 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Inventory%20management%20spreadsheet%20with%20stock%20levels%20and%20product%20lists&image_size=square',
    url: '#',
  },
  {
    id: 'project-tracker',
    name: 'Project Management Template',
    description: 'Manage tasks, deadlines, and team progress with Gantt charts and status trackers.',
    price: '$15',
    originalPrice: '$25',
    type: 'paid',
    platform: 'Etsy',
    rating: 4.7,
    reviews: 234,
    features: ['Task management', 'Gantt chart', 'Team assignments', 'Progress tracking', 'Milestone tracking'],
    image: 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Project%20management%20template%20with%20Gantt%20chart%20and%20task%20list&image_size=square',
    url: '#',
  },
  {
    id: 'sales-dashboard',
    name: 'Sales Dashboard',
    description: 'Real-time sales analytics with revenue tracking, top products, and customer insights.',
    price: '$39',
    originalPrice: '$59',
    type: 'paid',
    platform: 'Gumroad',
    rating: 4.9,
    reviews: 67,
    features: ['Revenue tracking', 'Top products', 'Customer analysis', 'Monthly trends', 'Sales forecasts'],
    image: 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Sales%20dashboard%20spreadsheet%20with%20revenue%20charts%20and%20analytics&image_size=square',
    url: '#',
  },
];

const courses = [
  {
    id: 'excel-mastery',
    name: 'Excel Mastery Course',
    description: 'From beginner to advanced - master Excel functions, pivot tables, and automation.',
    price: '$49',
    originalPrice: '$99',
    type: 'course',
    platform: 'Online',
    rating: 4.9,
    reviews: 512,
    features: ['20+ video lessons', '50+ practice exercises', 'Certificate of completion', 'Lifetime access'],
    duration: '10 hours',
    image: 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Excel%20mastery%20course%20learning%20material%20with%20spreadsheet%20examples&image_size=square',
    url: '#',
  },
  {
    id: 'google-sheets-pro',
    name: 'Google Sheets Pro',
    description: 'Become a Google Sheets expert with QUERY, IMPORTRANGE, and advanced formulas.',
    price: '$39',
    originalPrice: '$79',
    type: 'course',
    platform: 'Online',
    rating: 4.8,
    reviews: 389,
    features: ['15+ video lessons', '30+ practice exercises', 'Certificate of completion', 'Lifetime access', 'Community support'],
    duration: '8 hours',
    image: 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Google%20Sheets%20advanced%20course%20with%20formulas%20and%20data%20visualization&image_size=square',
    url: '#',
  },
];

const title = `Templates | ${SITE.title}`;
const description = 'Professional Excel and Google Sheets templates for personal and business use. Free and premium templates to save you time.';
const canonical = `${SITE.url}/templates/`;
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-primary-50 via-white to-accent-50 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">Spreadsheet Templates & Courses</h1>
      <p class="text-lg text-gray-600">Save time with professionally designed templates. Start free, upgrade for more power.</p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Free Templates Section -->
    <div class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-10 h-10 rounded-full bg-green-500 flex items-center justify-center text-white font-bold">🎁</div>
        <div>
          <h2 class="text-xl font-bold text-gray-900">Free Templates</h2>
          <p class="text-sm text-gray-500">Start with our free templates - no credit card required</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {freeTemplates.map((template) => (
          <a href={template.url} class="group block bg-white border-2 border-green-200 rounded-xl overflow-hidden hover:shadow-lg transition-all">
            <div class="relative">
              <div class="aspect-square bg-gray-100 overflow-hidden">
                <img src={template.image} alt={template.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
              </div>
              <div class="absolute top-3 right-3">
                <span class="inline-flex items-center px-2 py-1 rounded-full bg-green-500 text-white text-xs font-semibold">
                  FREE
                </span>
              </div>
            </div>
            <div class="p-5">
              <div class="flex items-center justify-between mb-2">
                <span class="inline-flex items-center px-2 py-1 rounded-full bg-green-50 text-xs font-medium text-green-700">
                  {template.platform}
                </span>
              </div>
              <h3 class="text-lg font-bold text-gray-900 group-hover:text-green-600 transition-colors mb-2">{template.name}</h3>
              <p class="text-sm text-gray-500 mb-4 line-clamp-2">{template.description}</p>
              <div class="flex flex-wrap gap-1 mb-4">
                {template.features.slice(0, 3).map((feature) => (
                  <span class="text-xs px-2 py-1 rounded bg-green-50 text-green-700">{feature}</span>
                ))}
              </div>
              <button class="w-full px-4 py-2 rounded-lg bg-green-500 text-white text-sm font-medium hover:bg-green-600 transition-colors">
                Get Free Template
              </button>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Conversion Funnel CTA -->
    <div class="mb-12 p-6 rounded-xl bg-gradient-to-r from-primary-500 to-accent-500 text-white">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <h3 class="text-xl font-bold mb-2">Ready to Level Up?</h3>
          <p class="text-white/80">Upgrade to premium templates and courses for advanced features and personalized support.</p>
        </div>
        <a href="#premium" class="px-6 py-3 rounded-xl bg-white text-primary-600 font-semibold hover:bg-gray-100 transition-colors">
          Explore Premium
        </a>
      </div>
    </div>

    <!-- Premium Templates Section -->
    <div id="premium" class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-10 h-10 rounded-full bg-primary-500 flex items-center justify-center text-white font-bold">⭐</div>
        <div>
          <h2 class="text-xl font-bold text-gray-900">Premium Templates</h2>
          <p class="text-sm text-gray-500">Professional-grade templates with advanced features and support</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {paidTemplates.map((template) => (
          <a href={template.url} class="group block bg-white border border-gray-200 rounded-xl overflow-hidden hover:shadow-lg transition-all">
            <div class="aspect-square bg-gray-100 overflow-hidden">
              <img src={template.image} alt={template.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            </div>
            <div class="p-5">
              <div class="flex items-center justify-between mb-2">
                <span class="inline-flex items-center px-2 py-1 rounded-full bg-primary-50 text-xs font-medium text-primary-700">
                  {template.platform}
                </span>
                <div class="flex items-center gap-1">
                  <svg class="w-4 h-4 text-yellow-500" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  <span class="text-sm font-medium text-gray-700">{template.rating}</span>
                  <span class="text-xs text-gray-400">({template.reviews})</span>
                </div>
              </div>
              <h3 class="text-lg font-bold text-gray-900 group-hover:text-primary-500 transition-colors mb-2">{template.name}</h3>
              <p class="text-sm text-gray-500 mb-4 line-clamp-2">{template.description}</p>
              <div class="flex flex-wrap gap-1 mb-4">
                {template.features.slice(0, 3).map((feature) => (
                  <span class="text-xs px-2 py-1 rounded bg-gray-100 text-gray-600">{feature}</span>
                ))}
              </div>
              <div class="flex items-center justify-between">
                <div>
                  <span class="text-xl font-bold text-primary-600">{template.price}</span>
                  <span class="text-sm text-gray-400 line-through ml-2">{template.originalPrice}</span>
                </div>
                <button class="px-4 py-2 rounded-lg bg-primary-500 text-white text-sm font-medium hover:bg-primary-600 transition-colors">
                  Buy Now
                </button>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Courses Section -->
    <div class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-10 h-10 rounded-full bg-accent-500 flex items-center justify-center text-white font-bold">📚</div>
        <div>
          <h2 class="text-xl font-bold text-gray-900">Online Courses</h2>
          <p class="text-sm text-gray-500">Master spreadsheet skills with our comprehensive video courses</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {courses.map((course) => (
          <a href={course.url} class="group block bg-white border border-gray-200 rounded-xl overflow-hidden hover:shadow-lg transition-all">
            <div class="flex">
              <div class="w-40 flex-shrink-0">
                <img src={course.image} alt={course.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
              </div>
              <div class="p-5 flex-1">
                <div class="flex items-center justify-between mb-2">
                  <span class="inline-flex items-center px-2 py-1 rounded-full bg-accent-50 text-xs font-medium text-accent-700">
                    {course.platform}
                  </span>
                  <div class="flex items-center gap-1">
                    <svg class="w-4 h-4 text-yellow-500" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    <span class="text-sm font-medium text-gray-700">{course.rating}</span>
                  </div>
                </div>
                <h3 class="text-lg font-bold text-gray-900 group-hover:text-accent-600 transition-colors mb-2">{course.name}</h3>
                <p class="text-sm text-gray-500 mb-3 line-clamp-2">{course.description}</p>
                <div class="flex items-center gap-3 mb-4">
                  <span class="text-xs px-2 py-1 rounded bg-gray-100 text-gray-600">📖 {course.duration}</span>
                  <span class="text-xs px-2 py-1 rounded bg-gray-100 text-gray-600">{course.reviews} students</span>
                </div>
                <div class="flex items-center justify-between">
                  <div>
                    <span class="text-xl font-bold text-accent-600">{course.price}</span>
                    <span class="text-sm text-gray-400 line-through ml-2">{course.originalPrice}</span>
                  </div>
                  <button class="px-4 py-2 rounded-lg bg-accent-500 text-white text-sm font-medium hover:bg-accent-600 transition-colors">
                    Enroll Now
                  </button>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Free Trial CTA -->
    <div class="p-6 rounded-xl bg-gradient-to-r from-accent-50 to-blue-50 border border-accent-200">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Try Premium for Free</h3>
          <p class="text-sm text-gray-600">Get 7 days of free access to all premium templates and courses. Cancel anytime.</p>
        </div>
        <button class="px-6 py-3 rounded-xl bg-accent-500 text-white font-medium hover:bg-accent-600 transition-colors">
          Start Free Trial
        </button>
      </div>
    </div>
  </section>
</BaseLayout>