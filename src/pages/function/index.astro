---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, CATEGORIES } from '../../utils/config';
import { generateBreadcrumbSchema } from '../../utils/seo';

// Collect all function data
const functions = [];
const categories = {};

// Dynamically import all JSON data files
const dataModules = import.meta.glob('../../data/functions/**/*.json', { eager: true });

for (const path in dataModules) {
  const fn = dataModules[path];
  if (fn && fn.name) {
    functions.push(fn);
    const cat = fn.category || 'other';
    if (!categories[cat]) categories[cat] = [];
    categories[cat].push(fn);
  }
}

// Sort functions alphabetically within each category
for (const cat in categories) {
  categories[cat].sort((a, b) => a.name.localeCompare(b.name));
}

const title = `All Functions | ${SITE.title}`;
const description = 'Browse all Excel and Google Sheets functions by name or category.';
const canonical = `${SITE.url}/function/`;
const breadcrumbs = [{ name: 'Home', url: SITE.url }, { name: 'Functions', url: canonical }];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={[generateBreadcrumbSchema(breadcrumbs)]}>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900">All Functions</h1>
      <p class="mt-2 text-gray-600">Complete reference for {functions.length} Excel & Google Sheets functions</p>
    </div>

    <!-- Search -->
    <div class="mb-6">
      <div class="relative max-w-md">
        <input
          id="function-search"
          type="search"
          placeholder="Filter functions by name, category, or description..."
          autocomplete="off"
          class="w-full h-12 pl-10 pr-4 rounded-xl bg-gray-50 border border-gray-200 text-sm focus:outline-none focus:border-primary-500 focus:ring-2 focus:ring-primary-500/20 transition-all"
        />
        <svg class="absolute left-3 top-3.5 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
      <div id="search-status" class="mt-3 text-sm text-gray-600 hidden"></div>
    </div>

    <!-- No results message -->
    <div id="no-results" class="text-center py-16 hidden">
      <p class="text-gray-500">No functions match your search. Try a different term.</p>
    </div>

    <!-- Category sections -->
    <div id="function-list">
      {CATEGORIES.map((cat) => {
        const catFunctions = categories[cat.slug] || [];
        if (catFunctions.length === 0) return null;
        return (
          <div class="category-section mb-10" data-category={cat.slug}>
            <div class="flex items-center gap-2 mb-4">
              <span class="text-xl">{cat.icon}</span>
              <h2 class="text-xl font-semibold text-gray-900">{cat.name}</h2>
              <span class="text-xs text-gray-400 bg-gray-50 px-2 py-1 rounded-full">{catFunctions.length}</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
              {catFunctions.map((fn) => (
                <a
                  href={`/function/${fn.slug}/`}
                  class="function-card group block p-4 rounded-lg bg-white border border-gray-200 hover:border-primary-500 hover:shadow-md transition-all"
                  data-name={fn.name.toLowerCase()}
                  data-description={(fn.tldr || fn.description || '').toLowerCase()}
                  data-category={(fn.category || '').toLowerCase()}
                >
                  <div class="flex items-center justify-between">
                    <h3 class="text-base font-semibold text-gray-900 group-hover:text-primary-500 transition-colors font-mono">{fn.name.toUpperCase()}</h3>
                    <svg class="w-4 h-4 text-gray-300 group-hover:text-primary-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </div>
                  <p class="mt-1 text-sm text-gray-500 line-clamp-2">{fn.tldr || fn.description}</p>
                </a>
              ))}
            </div>
          </div>
        );
      })}
    </div>

    {Object.keys(categories).length === 0 && (
      <div class="text-center py-16">
        <p class="text-gray-500">No functions yet. Content is being added!</p>
      </div>
    )}
  </section>

  <script>
    // Client-side function search/filter (works in static build)
    const searchInput = document.getElementById('function-search');
    const categorySections = Array.from(document.querySelectorAll('.category-section'));
    const noResults = document.getElementById('no-results');
    const searchStatus = document.getElementById('search-status');

    function escapeHtml(str) {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    function applyFilter(query) {
      const q = (query || '').trim().toLowerCase();
      let visibleCount = 0;

      categorySections.forEach((section) => {
        const cards = Array.from(section.querySelectorAll('.function-card'));
        let visibleInCategory = 0;
        cards.forEach((card) => {
          const name = card.getAttribute('data-name') || '';
          const desc = card.getAttribute('data-description') || '';
          const cat = card.getAttribute('data-category') || '';
          const matches = !q || name.includes(q) || desc.includes(q) || cat.includes(q);
          card.style.display = matches ? '' : 'none';
          if (matches) {
            visibleInCategory++;
            visibleCount++;
          }
        });
        // Hide the entire category section if no cards are visible
        section.style.display = visibleInCategory > 0 ? '' : 'none';
      });

      // Show/hide the no-results placeholder
      if (noResults) noResults.classList.toggle('hidden', !(q && visibleCount === 0));

      // Update the result count / clear-search status line
      if (searchStatus) {
        if (q) {
          searchStatus.innerHTML =
            'Found <span class="font-medium text-primary-500">' +
            visibleCount +
            '</span> function' +
            (visibleCount === 1 ? '' : 's') +
            ' matching "<span class="font-medium">' +
            escapeHtml(query) +
            '</span>" <a href="/function/" class="ml-2 text-gray-400 hover:text-gray-600 underline">Clear search</a>';
          searchStatus.classList.remove('hidden');
        } else {
          searchStatus.classList.add('hidden');
          searchStatus.innerHTML = '';
        }
      }
    }

    // On load: pre-fill from ?q= (covers homepage / header / mobile search forms)
    const urlParams = new URLSearchParams(window.location.search);
    const initialQuery = urlParams.get('q') || '';
    if (initialQuery) {
      searchInput.value = initialQuery;
      applyFilter(initialQuery);
    }

    // Real-time filter as the user types
    searchInput.addEventListener('input', (e) => {
      const value = e.target.value;
      const url = new URL(window.location.href);
      if (value) {
        url.searchParams.set('q', value);
      } else {
        url.searchParams.delete('q');
      }
      window.history.replaceState({}, '', url);
      applyFilter(value);
    });
  </script>
</BaseLayout>
